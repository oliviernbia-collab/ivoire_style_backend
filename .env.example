NODE_ENV=development
PORT=5000
# Adresse publique de l'API. En mode Jèko : obligatoirement HTTPS (URL ngrok en local), car Jèko y renvoie le client après paiement
API_PUBLIC_URL=http://localhost:5000

# MySQL / MariaDB (XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_style

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_DAYS=30

# Origines autorisées (CORS), séparées par des virgules
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Paiements : "sandbox" active la simulation Mobile Money (jamais en production)
# PAYMENT_MODE=jeko : vrais paiements via Jèko (https://jeko.africa) - encaissements, remboursements et reversements
PAYMENT_MODE=sandbox
PAYMENT_WEBHOOK_SECRET=change_me_webhook_secret

# Jèko (obligatoire si PAYMENT_MODE=jeko) : Dashboard Business > Paramètres > API & Webhooks
# URL du webhook à déclarer chez Jèko (HTTPS public) : https://<votre-domaine>/api/v1/payments/webhooks/jeko
JEKO_API_URL=https://api.jeko.africa
JEKO_API_KEY=
JEKO_API_KEY_ID=
JEKO_STORE_ID=
JEKO_WEBHOOK_SECRET=

# Cloudinary : stockage des images, vidéos et pièces justificatives (rien n'est stocké sur le serveur)
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret
CLOUDINARY_FOLDER=ivoire-style

# Lien du site web (e-mails de réinitialisation)
WEB_URL=http://localhost:5173
